{
    "name": "helgesverre/milvus",
    "description": "PHP Client for the Milvus Rest API",
    "keywords": [
        "laravel",
        "vectorstore",
        "vector",
        "database",
        "milvus",
        "sdk",
        "php"
    ],
    "homepage": "https://github.com/helgesverre/milvus",
    "license": "MIT",
    "authors": [
        {
            "name": "Helge Sverre",
            "email": "helge.sverre@gmail.com",
            "role": "Developer"
        }
    ],
    "require": {
        "php": "^8.3",
        "saloonphp/saloon": "^4.0",
        "spatie/laravel-package-tools": "^1.93"
    },
    "require-dev": {
        "laravel/pint": "^1.0",
        "larastan/larastan": "^2.9|^3.10",
        "orchestra/testbench": "^8.37|^9.17|^10.11|^11.1",
        "pestphp/pest": "^2.36|^3.8|^4.7",
        "phpstan/extension-installer": "^1.1",
        "phpstan/phpstan-deprecation-rules": "^1.0|^2.0",
        "phpstan/phpstan-phpunit": "^1.0|^2.0"
    },
    "autoload": {
        "psr-4": {
            "HelgeSverre\\Milvus\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "HelgeSverre\\Milvus\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "analyse": "vendor/bin/phpstan analyse",
        "test": "vendor/bin/pest --no-coverage",
        "test:unit": "vendor/bin/pest tests/Unit tests/ArchTest.php --no-coverage",
        "test:integration": "vendor/bin/pest tests/Feature/CollectionTest.php --no-coverage",
        "test-coverage": "vendor/bin/pest --coverage",
        "format": "vendor/bin/pint",
        "format:test": "vendor/bin/pint --test"
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true,
            "phpstan/extension-installer": true
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "HelgeSverre\\Milvus\\MilvusServiceProvider"
            ],
            "aliases": {
                "Milvus": "HelgeSverre\\Milvus\\Facades\\Milvus"
            }
        }
    }
}
